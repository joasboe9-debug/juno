const tabButtons = document.querySelectorAll('.nav-button');
const tabPanels = document.querySelectorAll('.tab-panel');
const chatForm = document.getElementById('chat-form');
const chatInput = document.getElementById('chat-input');
const chatBox = document.getElementById('chat-box');
const promptInput = document.getElementById('prompt-input');
const generateButton = document.getElementById('generate-button');
const presetButtons = document.querySelectorAll('.preset-button');
const canvas = document.getElementById('pixel-art-canvas');
const ctx = canvas.getContext('2d');

const chatResponses = [
  'Juno Core v0.1 is a lightweight assistant focused on clear, direct answers.',
  'I can help with brainstorming, summarizing, planning, and simple creative prompts.',
  'Juno is designed to feel friendly, simple, and fast for everyday conversations.',
  'This prototype is built to showcase the chat experience before connecting a real backend model.'
];

function switchTab(name) {
  tabButtons.forEach((button) => {
    const isActive = button.dataset.tab === name;
    button.classList.toggle('active', isActive);
  });

  tabPanels.forEach((panel) => {
    panel.classList.toggle('active', panel.id === `${name}-tab`);
  });
}

tabButtons.forEach((button) => {
  button.addEventListener('click', () => switchTab(button.dataset.tab));
});

function createMessage(role, text) {
  const message = document.createElement('div');
  message.className = `message ${role}`;

  if (role === 'assistant') {
    const avatar = document.createElement('div');
    avatar.className = 'avatar';
    avatar.textContent = 'J';
    message.appendChild(avatar);
  }

  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  const paragraph = document.createElement('p');
  paragraph.textContent = text;
  bubble.appendChild(paragraph);
  message.appendChild(bubble);

  chatBox.appendChild(message);
  chatBox.scrollTop = chatBox.scrollHeight;
}

chatForm.addEventListener('submit', (event) => {
  event.preventDefault();
  const value = chatInput.value.trim();

  if (!value) {
    return;
  }

  createMessage('user', value);
  chatInput.value = '';

  const response = chatResponses[Math.floor(Math.random() * chatResponses.length)];

  setTimeout(() => {
    createMessage('assistant', response);
  }, 250);
});

function drawPixelArt(scene) {
  const size = 16;
  const cell = canvas.width / size;

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const palette = {
    sky: '#8ecae6',
    ground: '#4f7c5c',
    groundDark: '#2f4f3f',
    building: '#d8c3a5',
    accent: '#ffb703',
    shadow: '#1f2937',
    moon: '#fdf5bf',
    wall: '#7d7d9c',
    plant: '#5fd38d'
  };

  const colors = {
    'Forest Shrine': {
      sky: '#8ecae6',
      ground: '#426b4d',
      building: '#d9b38c',
      accent: '#e9c46a',
      shadow: '#243b36',
      plant: '#69d2a0'
    },
    'Neon Alley': {
      sky: '#0d1224',
      ground: '#2d1e54',
      building: '#5d4ad1',
      accent: '#ff4fd8',
      shadow: '#120b1b',
      plant: '#38d39f'
    },
    'Moon Camp': {
      sky: '#1a223d',
      ground: '#2d3748',
      building: '#b8d4f7',
      accent: '#f5d76e',
      shadow: '#0b1120',
      plant: '#7ee3a6'
    }
  };

  const chosenPalette = colors[scene] || colors['Forest Shrine'];

  ctx.fillStyle = chosenPalette.sky;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = chosenPalette.moon;
  ctx.fillRect(34, 28, 18, 18);

  ctx.fillStyle = chosenPalette.ground;
  ctx.fillRect(0, 170, canvas.width, 86);

  ctx.fillStyle = chosenPalette.groundDark;
  for (let x = 0; x < size; x += 2) {
    ctx.fillRect(x * cell, 178 + (x % 3) * 2, cell * 2, 8);
  }

  ctx.fillStyle = chosenPalette.building;
  ctx.fillRect(56, 96, 50, 74);
  ctx.fillRect(126, 82, 68, 88);
  ctx.fillRect(92, 122, 16, 48);

  ctx.fillStyle = chosenPalette.shadow;
  ctx.fillRect(60, 104, 42, 10);
  ctx.fillRect(130, 92, 60, 10);

  ctx.fillStyle = chosenPalette.accent;
  ctx.fillRect(88, 84, 14, 14);
  ctx.fillRect(154, 96, 18, 18);

  ctx.fillStyle = chosenPalette.plant;
  ctx.fillRect(34, 166, 10, 16);
  ctx.fillRect(206, 166, 12, 18);
  ctx.fillRect(238, 168, 10, 14);

  ctx.fillStyle = 'rgba(255,255,255,0.14)';
  ctx.fillRect(0, 0, canvas.width, 8);
}

function generateArtFromPrompt(promptInputValue) {
  const cleaned = (promptInputValue || '').trim();
  const prompt = cleaned || 'Forest Shrine';
  const scene = prompt.toLowerCase().includes('neon') ? 'Neon Alley' : prompt.toLowerCase().includes('moon') ? 'Moon Camp' : 'Forest Shrine';

  drawPixelArt(scene);

  const label = `Generated scene: ${scene}`;

  const existing = canvas.getAttribute('data-label');
  if (existing) {
    canvas.setAttribute('data-label', label);
  } else {
    canvas.setAttribute('data-label', label);
  }
}

generateButton.addEventListener('click', () => {
  generateArtFromPrompt(promptInput.value);
});

presetButtons.forEach((button) => {
  button.addEventListener('click', () => {
    const preset = button.dataset.preset;
    promptInput.value = preset;
    generateArtFromPrompt(preset);
  });
});

promptInput.value = 'Forest Shrine';
drawPixelArt('Forest Shrine');
